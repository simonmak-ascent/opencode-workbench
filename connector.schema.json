{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simonplmak-cloud/opencode-workbench/main/connector.schema.json",
  "title": "OpenCode Workbench connector manifest",
  "type": "object",
  "required": ["name", "title", "description", "version", "transport"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "transport": {
      "type": "object",
      "required": ["type", "command"],
      "properties": {
        "type": { "enum": ["stdio", "remote"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "env": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transports": { "type": "object" },
    "mcp": { "type": "object" },
    "targets": { "type": "object" },
    "secrets": { "type": "object" },
    "components": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "core": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
