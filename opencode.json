{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "v0": {
      "type": "remote",
      "url": "https://v0.app/api/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "timeout": 60000
    },
    "surrealdb": {
      "type": "remote",
      "url": "https://mcp.surreal.cloud",
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "remote",
      "url": "https://mcp.github.com",
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-brave-search"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-postgres", "postgresql://opencode@localhost:5432/memory"],
      "enabled": true,
      "timeout": 15000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com",
      "enabled": true,
      "timeout": 30000
    },
    "perplexity": {
      "type": "local",
      "command": ["node", "/home/node/.local/bin/perplexity-agent-mcp/dist/index.js"],
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}"
      },
      "enabled": true,
      "timeout": 600000
    },
    "mermaid": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-mermaid/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "echarts": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-echarts/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "browser-mcp": {
      "type": "local",
      "command": ["npx", "@anthropic-ai/browser-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "design-system": {
      "type": "remote",
      "url": "https://mcp.designsystem.ai",
      "enabled": true,
      "timeout": 30000
    },
    "difflens": {
      "type": "remote",
      "url": "https://mcp.difflens.ai",
      "enabled": true,
      "timeout": 30000
    }
  }
}
