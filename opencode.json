{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "instructions": [
    "AGENTS.md"
  ],
  "autoupdate": true,
  "small_model": "deepseek/deepseek-v4-flash",
  "subagent_depth": 3,
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/credentials.*": "deny",
      "**/secrets.*": "deny"
    },
    "bash": {
      "*": "allow",
      "pnpm check*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm evals*": "allow",
      "pnpm install*": "allow",
      "pnpm add*": "allow",
      "pnpm update*": "allow",
      "tsc*": "allow",
      "vitest*": "allow",
      "eslint*": "allow",
      "prettier*": "allow",
      "docker build*": "allow",
      "docker compose*": "allow",
      "npm install*": "allow",
      "npm test*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm run check*": "allow",
      "yarn*": "allow",
      "make*": "allow",
      "cmake*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "node --test*": "allow",
      "npx tsc*": "allow",
      "npx vitest*": "allow",
      "npx eslint*": "allow",
      "npx jest*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf *": "allow",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf /workspaces*": "allow",
      "rm -rf /tmp*": "allow",
      "rm -rf ~*": "deny",
      "rm -rf /root*": "deny",
      "rm -rf /etc*": "deny",
      "rm -rf /var/lib/postgresql*": "deny",
      "sudo *": "deny"
    },
    "edit": "allow",
    "external_directory": "allow",
    "task": {
      "code-reviewer": "allow",
      "test-writer": "allow",
      "security-reviewer": "allow",
      "explorer": "allow",
      "explore": "allow",
      "general": "allow",
      "scout": "allow",
      "*": "allow"
    },
    "question": "deny"
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "plugin": [
    "opencode-env-protect",
    "opencode-sentry-monitor",
    "./plugins/memory.ts",
    "./plugins/doc-tools.ts"
  ],
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "api": "https://api.deepseek.com/v1",
      "env": [
        "DEEPSEEK_API_KEY"
      ],
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "cost": {
            "input": 0.000435,
            "output": 0.00087
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "cost": {
            "input": 0.00014,
            "output": 0.00028
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 45000
      }
    },
    "perplexity": {
      "name": "Perplexity",
      "api": "https://api.perplexity.ai",
      "env": [
        "PERPLEXITY_API_KEY"
      ],
      "models": {
        "sonar-pro": {
          "id": "sonar-pro",
          "name": "Sonar Pro",
          "reasoning": false,
          "cost": {
            "input": 0.003,
            "output": 0.015
          },
          "limit": {
            "context": 200000,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "sonar-reasoning-pro": {
          "id": "sonar-reasoning-pro",
          "name": "Sonar Reasoning Pro",
          "reasoning": true,
          "cost": {
            "input": 0.003,
            "output": 0.015
          },
          "limit": {
            "context": 127024,
            "output": 127024
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "sonar": {
          "id": "sonar",
          "name": "Sonar",
          "reasoning": false,
          "cost": {
            "input": 0.001,
            "output": 0.001
          },
          "limit": {
            "context": 127024,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "apiKey": "{env:PERPLEXITY_API_KEY}"
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "api": "https://openrouter.ai/api/v1",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "anthropic/claude-sonnet-4-5": {
          "id": "anthropic/claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5 (OpenRouter)",
          "reasoning": true,
          "cost": {
            "input": 0.003,
            "output": 0.015
          },
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "google/gemini-2.5-pro": {
          "id": "google/gemini-2.5-pro",
          "name": "Gemini 2.5 Pro (OpenRouter)",
          "reasoning": true,
          "cost": {
            "input": 0.00125,
            "output": 0.01
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openai/gpt-5.5": {
          "id": "openai/gpt-5.5",
          "name": "GPT-5.5 (OpenRouter)",
          "reasoning": true,
          "cost": {
            "input": 0.005,
            "output": 0.03
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 45000
      }
    },
    "zen": {
      "name": "OpenCode Zen",
      "api": "https://zen.opencode.ai/v1",
      "env": [
        "OPENCODE_API_KEY"
      ],
      "models": {
        "zen-medium": {
          "id": "zen-medium",
          "name": "Zen Medium",
          "reasoning": true,
          "cost": {
            "input": 0,
            "output": 0
          },
          "limit": {
            "context": 1048576,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "kimi": {
      "name": "Kimi (Moonshot)",
      "api": "https://api.moonshot.cn/v1",
      "env": [
        "MOONSHOT_API_KEY"
      ],
      "models": {
        "kimi-k3": {
          "id": "kimi-k3",
          "name": "Kimi K3",
          "reasoning": true,
          "cost": {
            "input": 0.00087,
            "output": 0.00348
          },
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "apiKey": "{env:MOONSHOT_API_KEY}"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 60000
    },
    "vdd": {
      "type": "local",
      "command": [
        "node",
        "/workspaces/vision_driven_design/packages/vdd-mcp/dist/stdio.js"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "clerk": {
      "type": "remote",
      "url": "https://mcp.clerk.com/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:VERCEL_ACCESS_TOKEN}"
      }
    },
    "surrealdb": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.local/bin/surreal-mcp-shim.mjs"
      ],
      "environment": {
        "SURREALDB_URL": "{env:SURREAL_URL}",
        "SURREALDB_NS": "{env:SURREAL_NAMESPACE}",
        "SURREALDB_DB": "{env:SURREAL_DATABASE}",
        "SURREALDB_USER": "{env:SURREAL_USERNAME}",
        "SURREALDB_PASS": "{env:SURREAL_PASSWORD}",
        "SURREALDB_TOKEN": "{env:SURREAL_TOKEN}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "github": {
      "type": "local",
      "command": [
        "/home/node/.local/bin/github-mcp-server",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "perplexity": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.local/bin/perplexity-agent-mcp/index.js"
      ],
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}"
      },
      "enabled": true,
      "timeout": 600000
    },
    "brave-search": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/@modelcontextprotocol/server-brave-search/dist/index.js"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "postgres": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.local/bin/postgres-mcp-shim.mjs"
      ],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "browserless": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.local/bin/browserless-mcp/dist/index.js"
      ],
      "environment": {
        "BROWSERLESS_HOST": "localhost",
        "BROWSERLESS_PORT": "3000",
        "BROWSERLESS_TOKEN": "{env:BROWSERLESS_TOKEN}",
        "BROWSERLESS_PROTOCOL": "http"
      },
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/@playwright/mcp/cli.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "esg-hub": {
      "type": "local",
      "command": [
        "node",
        "/workspaces/esg-hub/mcp-server/dist/index.js"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "humanity4ai": {
      "type": "local",
      "command": [
        "node",
        "/workspaces/project_human/mcp-servers/dist/mcp-server.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "mermaid": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/mcp-mermaid/build/index.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "saga": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/saga-mcp/dist/index.js"
      ],
      "environment": {
        "DB_PATH": "/workspaces/workbench/.saga/.tracker.db"
      },
      "enabled": true
    },
    "echarts": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/mcp-echarts/build/index.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "shadcn": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/@jpisnice/shadcn-ui-mcp-server/build/index.js"
      ],
      "environment": {
        "GITHUB_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "swagger-testcase": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/swagger-testcase-mcp/dist/index.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "design-system": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/mcp-design-system-extractor/dist/index.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "browser-mcp": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.local/bin/browser-mcp/browser-mcp-server-v2.js"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "designlang": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "designlang",
        "mcp",
        "--output-dir",
        "/home/node/design-extract-output"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "difflens": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "difflens-cli"
      ],
      "environment": {
        "npm_config_ignore_scripts": "true"
      },
      "enabled": true,
      "timeout": 120000
    },
    "sentry": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/@sentry/mcp-server/dist/index.js"
      ],
      "environment": {
        "SENTRY_ACCESS_TOKEN": "{env:SENTRY_AUTH_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "google-search": {
      "type": "local",
      "command": [
        "node",
        "/home/node/.npm-global/lib/node_modules/@adenot/mcp-google-search/build/index.js"
      ],
      "environment": {
        "GOOGLE_API_KEY": "{env:GOOGLE_API_KEY}",
        "GOOGLE_CSE_ID": "{env:GOOGLE_CSE_ID}"
      },
      "enabled": false,
      "_disabled_reason": "Google Custom Search JSON API is EOL (403)"
    },
    "google-workspace": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "/home/node/.mcp/google-workspace-mcp:/app/config",
        "-e",
        "GOOGLE_CLIENT_ID={env:GOOGLE_CLIENT_ID}",
        "-e",
        "GOOGLE_CLIENT_SECRET={env:GOOGLE_CLIENT_SECRET}",
        "-e",
        "LOG_MODE=strict",
        "ghcr.io/aaronsb/google-workspace-mcp:latest"
      ],
      "enabled": false,
      "_disabled_reason": "Requires OAuth + GOOGLE_CLIENT_ID/SECRET (not configured)"
    },
    "ms-365": {
      "type": "local",
      "command": [
        "npx",
        "@softeria/ms-365-mcp-server"
      ],
      "environment": {
        "MS_CLIENT_ID": "{env:AZURE_CLIENT_ID}",
        "MS_CLIENT_SECRET": "{env:AZURE_CLIENT_SECRET}",
        "MS_TENANT_ID": "{env:AZURE_TENANT_ID}"
      },
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {env:STRIPE_SECRET_KEY}"
      }
    },
    "alibaba-cloud-ops": {
      "type": "local",
      "command": [
        "uvx",
        "alibaba-cloud-ops-mcp-server@latest"
      ],
      "environment": {
        "ALIBABA_CLOUD_ACCESS_KEY_ID": "{env:ALIBABA_CLOUD_ACCESS_KEY_ID}",
        "ALIBABA_CLOUD_ACCESS_KEY_SECRET": "{env:ALIBABA_CLOUD_ACCESS_KEY_SECRET}"
      },
      "enabled": true,
      "timeout": 120000
    }
  },
  "default_agent": "vdd",
  "agent": {
    "vdd": {
      "description": "Vision-driven development: start every task by establishing vision and traceability via the vdd MCP chain",
      "prompt": "You are a vision-driven development agent. Before implementing, establish vision.md, spec, plan and tasks with bidirectional traceability using the vdd MCP phase tools (vdd_e2e is retired; use vdd_init, vdd_vision, vdd_strategize, vdd_tactics, vdd_specify, vdd_plan, vdd_tasks, then vdd_validate). Prefer the spec-first workflow and reference file:line. Operate autonomously: do not ask for confirmation on reversible actions; decide, record the decision in the repo's register or memory, and continue. Fail closed only on the irreversible (production writes, destructive migrations, secret rotation, force-push, sudo). Keep text output to the minimum: no preamble, no narration of tool calls, no restating the task, no summaries; emit at most a one-line status and stop. Quote only the few relevant lines with path/to/file:line."
    }
  }
}
