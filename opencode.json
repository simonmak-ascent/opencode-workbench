{
  "$schema": "https://opencode.ai/config.json",
  "model": "kimi-for-coding/k3",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "n8n": {
      "type": "remote",
      "url": "https://simonmak.app.n8n.cloud/mcp-server/http",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_ACCESS_TOKEN}"
      }
    },
    "clerk": {
      "type": "remote",
      "url": "https://mcp.clerk.com/mcp",
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/home/node/.local/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true
    },
    "perplexity": {
      "type": "local",
      "command": ["node", "/home/node/.local/bin/perplexity-agent-mcp/index.js"],
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}"
      },
      "enabled": true,
      "timeout": 600000
    },
    "brave-search": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@modelcontextprotocol/server-brave-search/dist/index.js"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true,
      "timeout": 120000
    },
    "postgres": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@modelcontextprotocol/server-postgres/dist/index.js", "{env:DATABASE_URL}"],
      "enabled": true
    },
    "browserless": {
      "type": "local",
      "command": ["node", "/home/node/.local/bin/browserless-mcp/dist/index.js"],
      "environment": {
        "BROWSERLESS_HOST": "{env:BROWSERLESS_HOST}",
        "BROWSERLESS_PORT": "{env:BROWSERLESS_PORT}",
        "BROWSERLESS_TOKEN": "{env:BROWSERLESS_TOKEN}",
        "BROWSERLESS_PROTOCOL": "{env:BROWSERLESS_PROTOCOL}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@playwright/mcp/cli.js"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/figma-developer-mcp/dist/index.js"],
      "environment": {
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "mermaid": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-mermaid/build/index.js"],
      "enabled": true
    },
    "saga": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/saga-mcp/dist/index.js"],
      "enabled": true
    },
    "echarts": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-echarts/build/index.js"],
      "enabled": true
    },
    "surrealdb": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/surrealdb-mcp-server/build/index.js"],
      "environment": {
        "SURREALDB_URL": "{env:SURREALDB_URL}",
        "SURREALDB_USER": "{env:SURREALDB_USER}",
        "SURREALDB_PASS": "{env:SURREALDB_PASS}",
        "SURREALDB_NS": "{env:SURREALDB_NS}",
        "SURREALDB_DB": "{env:SURREALDB_DB}"
      },
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@jpisnice/shadcn-ui-mcp-server/build/index.js"],
      "environment": {
        "GITHUB_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true
    },
    "wcagc": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@wcagc/mcp/dist/stdio.js"],
      "environment": {
        "WCAGC_MCP_KEY": "{env:WCAGC_MCP_KEY}"
      },
      "enabled": false
    },
    "swagger-testcase": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/swagger-testcase-mcp/dist/index.js"],
      "enabled": true
    },
    "design-system": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-design-system-extractor/dist/index.js"],
      "enabled": true
    },
    "storybook": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@storybook/mcp/dist/index.js"],
      "enabled": false
    },
    "convertica": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/convertica-mcp/src/index.js"],
      "environment": {
        "CONVERTICA_API_KEY": "{env:CONVERTICA_API_KEY}"
      },
      "enabled": false
    },
    "sentry": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@sentry/mcp-server/dist/index.js"],
      "environment": {
        "SENTRY_ACCESS_TOKEN": "{env:SENTRY_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  }
}
