{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-pro",
  "lsp": true,
  "formatter": true,
  "plugin": [],
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "api": "https://api.deepseek.com/v1",
      "env": ["DEEPSEEK_API_KEY"],
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "cost": { "input": 0.000435, "output": 0.00087 },
          "limit": { "context": 1048576, "output": 393216 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "cost": { "input": 0.00014, "output": 0.00028 },
          "limit": { "context": 1048576, "output": 393216 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      },
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "opencode-go": {
      "name": "OpenCode Console Go",
      "api": "https://api.opencode.ai/v1",
      "env": ["OPENCODE_API_KEY"],
      "models": {
        "kimi-k3": {
          "id": "kimi-k3",
          "name": "Kimi K3 (via OpenCode)",
          "reasoning": true,
          "cost": { "input": 0.00087, "output": 0.00348 },
          "limit": { "context": 262144, "output": 262144 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      },
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "perplexity": {
      "name": "Perplexity",
      "api": "https://api.perplexity.ai",
      "env": ["PERPLEXITY_API_KEY"],
      "models": {
        "sonar-pro": {
          "id": "sonar-pro",
          "name": "Sonar Pro",
          "reasoning": false,
          "cost": { "input": 0.003, "output": 0.015 },
          "limit": { "context": 200000, "output": 8192 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "sonar-reasoning-pro": {
          "id": "sonar-reasoning-pro",
          "name": "Sonar Reasoning Pro",
          "reasoning": true,
          "cost": { "input": 0.003, "output": 0.015 },
          "limit": { "context": 127024, "output": 127024 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "sonar": {
          "id": "sonar",
          "name": "Sonar",
          "reasoning": false,
          "cost": { "input": 0.001, "output": 0.001 },
          "limit": { "context": 127024, "output": 8192 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      },
      "options": {
        "apiKey": "{env:PERPLEXITY_API_KEY}"
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "api": "https://openrouter.ai/api/v1",
      "env": ["OPENROUTER_API_KEY"],
      "models": {
        "anthropic/claude-sonnet-4-5": {
          "id": "anthropic/claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5 (OpenRouter)",
          "reasoning": true,
          "cost": { "input": 0.003, "output": 0.015 },
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "google/gemini-2.5-pro": {
          "id": "google/gemini-2.5-pro",
          "name": "Gemini 2.5 Pro (OpenRouter)",
          "reasoning": true,
          "cost": { "input": 0.00125, "output": 0.01 },
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "openai/gpt-5.5": {
          "id": "openai/gpt-5.5",
          "name": "GPT-5.5 (OpenRouter)",
          "reasoning": true,
          "cost": { "input": 0.005, "output": 0.03 },
          "limit": { "context": 272000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "n8n": {
      "type": "remote",
      "url": "https://simonmak.app.n8n.cloud/mcp-server/http",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:N8N_MCP_ACCESS_TOKEN}"
      }
    },
    "clerk": {
      "type": "remote",
      "url": "https://mcp.clerk.com/mcp",
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:VERCEL_ACCESS_TOKEN}"
      }
    },
    "github": {
      "type": "local",
      "command": ["/home/node/.local/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "perplexity": {
      "type": "local",
      "command": ["node", "/home/node/.local/bin/perplexity-agent-mcp/index.js"],
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}"
      },
      "enabled": true,
      "timeout": 600000
    },
    "brave-search": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@modelcontextprotocol/server-brave-search/dist/index.js"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true,
      "timeout": 120000
    },
    "postgres": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@modelcontextprotocol/server-postgres/dist/index.js", "{env:DATABASE_URL}"],
      "enabled": true,
      "timeout": 30000
    },
    "browserless": {
      "type": "local",
      "command": ["node", "/home/node/.local/bin/browserless-mcp/dist/index.js"],
      "environment": {
        "BROWSERLESS_HOST": "{env:BROWSERLESS_HOST}",
        "BROWSERLESS_PORT": "{env:BROWSERLESS_PORT}",
        "BROWSERLESS_TOKEN": "{env:BROWSERLESS_TOKEN}",
        "BROWSERLESS_PROTOCOL": "{env:BROWSERLESS_PROTOCOL}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@playwright/mcp/cli.js"],
      "enabled": true,
      "timeout": 60000
    },
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3333/mcp",
      "enabled": true,
      "_note": "Requires figma MCP HTTP server running: bash scripts/services/figma-mcp.sh start"
    },
    "mermaid": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-mermaid/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "saga": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/saga-mcp/dist/index.js"],
      "environment": {
        "DB_PATH": "{env:DB_PATH}"
      },
      "enabled": false,
      "_disabled_reason": "DB_PATH environment variable is not set"
    },
    "echarts": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-echarts/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "shadcn": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@jpisnice/shadcn-ui-mcp-server/build/index.js"],
      "environment": {
        "GITHUB_TOKEN": "{env:SIMONPLMAK_CLOUD_PAT}"
      },
      "enabled": true,
      "timeout": 30000
    },
    "swagger-testcase": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/swagger-testcase-mcp/dist/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "design-system": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/mcp-design-system-extractor/dist/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "sentry": {
      "type": "local",
      "command": ["node", "/home/node/.npm-global/lib/node_modules/@sentry/mcp-server/dist/index.js"],
      "environment": {
        "SENTRY_ACCESS_TOKEN": "{env:SENTRY_ACCESS_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
