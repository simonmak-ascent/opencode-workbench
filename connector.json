{
  "$schema": "https://raw.githubusercontent.com/simonplmak-cloud/workbench/main/connector.schema.json",
  "name": "workbench",
  "title": "OpenCode Workbench",
  "description": "Clones the OpenCode workbench installation onto Linux machines, locally or over SSH.",
  "version": "1.0.0",
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "github:simonplmak-cloud/workbench"],
    "env": []
  },
  "mcp": {
    "type": "local",
    "command": ["npx", "-y", "github:simonplmak-cloud/workbench"],
    "enabled": true,
    "timeout": 600000
  },
  "targets": {
    "local": { "mode": "local" },
    "ssh": { "mode": "ssh", "host": "<host>", "user": "<user>", "identityFile": "<optional>" }
  },
  "secrets": {
    "written": [],
    "template": "~/.env.workbench",
    "note": "The connector never reads or transmits secret values; it writes an empty template with the variable names the profile references."
  },
  "components": {
    "required": ["git", "curl", "node", "opencode"],
    "core": ["pnpm", "uv", "gh", "npm-mcps", "vendored-mcps", "skills", "plugins", "playwright-browsers"],
    "optional": ["github-mcp", "docker", "docker-containers", "data-tools"]
  }
}
