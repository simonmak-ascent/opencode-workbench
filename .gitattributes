# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts
*.sh text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.tar.gz binary
*.zip binary
